{
  "name": "vue-timelines",
  "description": "Vue timelines component",
  "author": "mygraphs",
  "license": "MIT",
  "version": "0.2.3",
  "type": "module",
  "private": false,
  "main": "dist/vue-timelines.umd.js",
  "module": "dist/vue-timelines.esm.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/vue-timelines.min.js",
  "jsdelivr": "dist/vue-timelines.min.js",
  "exports": {
    ".": {
      "import": "./dist/vue-timelines.esm.js",
      "require": "./dist/vue-timelines.umd.js",
      "types": "./dist/index.d.ts"
    },
    "./web-component": {
      "import": "./dist/vue-timelines-wc.js",
      "require": "./dist/vue-timelines-wc.js"
    },
    "./style": "./dist/vue-timelines.css",
    "./package.json": "./package.json"
  },
  "browser": {
    "./sfc": "src/vue-timelines.vue"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "README_INSTALL.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "serve": "vue-cli-service serve",
    "lint": "vue-cli-service lint",
    "build:demo": "vue-cli-service build --mode prod ",
    "build": "rimraf dist && cross-env NODE_ENV=production BUILD_FORMAT=all rollup --config rollup.config.js",
    "build:umd": "rimraf dist/vue-timelines.umd.js && cross-env NODE_ENV=production BUILD_FORMAT=umd rollup --config rollup.config.js",
    "build:es": "rimraf dist/vue-timelines.esm.js && cross-env NODE_ENV=production BUILD_FORMAT=es rollup --config rollup.config.js",
    "build:unpkg": "rimraf dist/vue-timelines.min.js && cross-env NODE_ENV=production BUILD_FORMAT=iife rollup --config rollup.config.js",
    "build:wc": "rimraf dist/vue-timelines-wc.js && cross-env NODE_ENV=production rollup --config rollup.config.wc.js",
    "build:all": "npm run build && npm run build:wc",
    "prepublishOnly": "npm run build:all",
    "prepack": "npm run build:all"
  },
  "peerDependencies": {
    "vue": ">= 3.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "cross-spawn": "^7.0.3",
    "@babel/runtime": "^7.26.10",
    "@vue/component-compiler-utils": {
      "postcss": "^8.4.31"
    },
    "yorkie": {
      "cross-spawn": "^7.0.3"
    },
    "@vue/cli-service": {
      "webpack-dev-server": "^4.15.1"
    }
  },
  "dependencies": {
    "@vuepic/vue-datepicker": "^5.4.0",
    "bootstrap": "^5.3.8",
    "core-js": "^3.46.0",
    "dayjs": "^1.11.19",
    "vue-final-modal": "^4.5.5",
    "vue3-slider": "^1.10.1",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-buble": "^1.0.3",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@vue/cli-plugin-babel": "~5.0.9",
    "@vue/cli-plugin-eslint": "~5.0.9",
    "@vue/cli-service": "~5.0.9",
    "@vue/compiler-sfc": "^3.5.24",
    "@babel/eslint-parser": "^7.26.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.32.0",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.1",
    "rollup": "^4.53.1",
    "rollup-plugin-postcss": "^4.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "rollup-plugin-vue": "^6.0.0",
    "vue": "^3.5.24"
  },
  "keywords": [
    "vue",
    "vue3",
    "vue-component",
    "timeline",
    "gantt",
    "project-management",
    "task-management",
    "web-component",
    "custom-element",
    "angular",
    "react",
    "vue-timeline",
    "vue-timelines"
  ],
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {
      "no-console": "off",
      "no-debugger": "off",
      "no-unused-vars": "off",
      "vue/multi-word-component-names": "off"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mygraphs/vue-timelines.git"
  },
  "bugs": {
    "url": "https://github.com/mygraphs/vue-timelines/issues"
  },
  "homepage": "https://github.com/mygraphs/vue-timelines#readme"
}
